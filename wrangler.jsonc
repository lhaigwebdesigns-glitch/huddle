{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huddle",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "Room", "class_name": "Room" },
      { "name": "Doc", "class_name": "Doc" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Doc"] }],
  // Free D1 database for feedback + usage. Create with: npx wrangler d1 create huddle
  // then paste the database_id here.
  "d1_databases": [
    { "binding": "DB", "database_name": "huddle", "database_id": "d0d8a445-6f2a-4e81-b4dc-0b463ea403ca" }
  ],
  "vars": {
    // Set to "true" to use a fake AI that echoes (handy for local testing with no keys).
    "MOCK_AI": "false",
    // Max AI replies per room per day (protects free quotas).
    "ROOM_DAILY_AI_LIMIT": "300"
  },
  // Cloudflare Workers AI: free daily allowance of open-weight models (Llama, Qwen, gpt-oss…).
  "ai": { "binding": "AI" }
  // Free R2 storage (10 GB) for uploads and AI images. `npm run setup:cloudflare` creates it.
  // Local dev simulates it on disk, so uploads work without an account.
  // R2 OFF (enable R2 in the dashboard, then rerun setup): "r2_buckets": [{ "binding": "FILES", "bucket_name": "huddle-files" }]
}
