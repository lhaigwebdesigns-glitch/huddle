# Huddle's self-hosted model (used when OLLAMA_BASE_URL or the OLLAMA_VPC tunnel is set).
# Build it once with:   ollama create huddle -f ollama/Modelfile
#
# Gemma 4 12B: strong tool calling and long context, and fits a 12 GB GPU (RX 9070 GRE).
# It replaced Qwen3 14B in Nov 2026. To go back: FROM qwen3:14b and num_ctx 12288.
# Ollama's default 4k context is too small for Huddle's system prompt, tools and chat
# history, so raise it; check `ollama ps` shows 100% GPU after changing num_ctx.
FROM gemma4:12b
PARAMETER num_ctx 16384
