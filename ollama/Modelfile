# Huddle's self-hosted model (used when OLLAMA_BASE_URL is set).
# Build it once with:   ollama create huddle -f ollama/Modelfile
# Ollama's default 4k context is too small for Huddle's system prompt, tools and chat
# history, so raise it. 16k fits a 14B model in ~12 GB of GPU memory; lower num_ctx
# (e.g. 12288) if `ollama ps` shows the model spilling onto the CPU.
FROM qwen3:14b
PARAMETER num_ctx 16384
